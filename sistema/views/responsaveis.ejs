<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Responsáveis</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 900px; margin: 20px auto; padding: 20px; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    input, button { padding: 6px; margin: 4px 0; }
    .erro { color: red; font-weight: bold; }
    .menu { margin-bottom: 20px; }
    .menu a { margin-right: 15px; }
  </style>
</head>
<body>
  <div class="menu">
    <a href="/">Início</a>
    <a href="/responsaveis">Responsáveis</a>
    <a href="/criancas">Crianças</a>
    <a href="/atendimentos">Atendimentos</a>
    <a href="/logout">Sair (<%= usuario.nome %>)</a>
  </div>

  <h2><%= responsavelEditando ? 'Editar Responsável' : 'Cadastrar Responsável' %></h2>

  <% if (erro) { %>
    <p class="erro"><%= erro %></p>
  <% } %>

  <form action="<%= responsavelEditando ? '/responsaveis/editar/' + responsavelEditando.id : '/responsaveis' %>" method="POST">
    <input type="text" name="nome" placeholder="Nome completo" value="<%= responsavelEditando ? responsavelEditando.nome : '' %>" required>
    <input type="text" name="cpf" placeholder="CPF (apenas números)" value="<%= responsavelEditando ? responsavelEditando.cpf : '' %>" required>
    <input type="email" name="email" placeholder="E-mail" value="<%= responsavelEditando ? responsavelEditando.email : '' %>" required>
    <input type="text" name="telefone" placeholder="Telefone" value="<%= responsavelEditando ? responsavelEditando.telefone : '' %>" required>
    <button type="submit"><%= responsavelEditando ? 'Salvar Alterações' : 'Cadastrar' %></button>
    <% if (responsavelEditando) { %>
      <a href="/responsaveis">Cancelar</a>
    <% } %>
  </form>

  <hr>

  <h3>Buscar Responsável</h3>
  <form action="/responsaveis" method="GET">
    <input type="text" name="busca" placeholder="Digite parte do nome..." value="<%= busca %>">
    <button type="submit">Buscar</button>
    <a href="/responsaveis">Limpar</a>
  </form>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>CPF</th>
        <th>E-mail</th>
        <th>Telefone</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% responsaveis.forEach(r => { %>
        <tr>
          <td><%= r.id %></td>
          <td><%= r.nome %></td>
          <td><%= r.cpf %></td>
          <td><%= r.email %></td>
          <td><%= r.telefone %></td>
          <td>
            <a href="/responsaveis?editar=<%= r.id %>">Editar</a>
            <form action="/responsaveis/excluir/<%= r.id %>" method="POST" style="display:inline;">
              <button type="submit" onclick="return confirm('Excluir este responsável?')">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>